generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id               String             @id @default(uuid())
  userId           String             @unique // Maps to Supabase auth.users.id
  name             String?
  focusAreas       String[]
  availableTime    Int?               // in minutes
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  dailyTargets     DailyTarget[]
  dailyReviews     DailyReview[]
  challenges       Challenge[]
  userAchievements UserAchievement[]
}

enum TargetStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  SKIPPED
  MISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model DailyTarget {
  id               String          @id @default(uuid())
  profileId        String
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  targetDate       DateTime        @db.Date
  category         String
  priority         Priority        @default(MEDIUM)
  startTime        DateTime?
  endTime          DateTime?
  estimatedDuration Int            // in minutes
  status           TargetStatus    @default(PENDING)
  isNext           Boolean         @default(false)
  executionOrder   Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sessions         TargetSession[]
  skipRecord       SkipRecord?
}

model TargetSession {
  id               String          @id @default(uuid())
  targetId         String
  target           DailyTarget     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime?
  duration         Int?            // actual duration in minutes
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}


enum SkipReason {
  NO_TIME
  TOO_TIRED
  TOO_DIFFICULT
  LOST_FOCUS
  UNEXPECTED_WORK
  NO_LONGER_RELEVANT
  OTHER
}

model SkipRecord {
  id               String          @id @default(uuid())
  targetId         String          @unique
  target           DailyTarget     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  reason           SkipReason
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model DailyReview {
  id               String          @id @default(uuid())
  profileId        String
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewDate       DateTime        @db.Date
  accomplishments  String?
  learnings        String?
  wentWell         String?
  wentWrong        String?
  improvements     String?
  rating           Int             // 1-5
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Challenge {
  id               String          @id @default(uuid())
  profileId        String
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String          // e.g. "21 Days of Linux"
  goal             String?
  dailyTarget      String?
  startDate        DateTime        @db.Date
  endDate          DateTime        @db.Date
  status           ChallengeStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  days             ChallengeDay[]
}

enum ChallengeDayStatus {
  SUCCESS
  PARTIAL
  MISSED
}

model ChallengeDay {
  id               String             @id @default(uuid())
  challengeId      String
  challenge        Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dayNumber        Int                // 1 to 21
  date             DateTime           @db.Date
  status           ChallengeDayStatus
  focusTime        Int?               // in minutes
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Achievement {
  id               String             @id @default(uuid())
  title            String
  description      String
  icon             String?
  criteria         String             // internal criteria code
  createdAt        DateTime           @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id               String          @id @default(uuid())
  profileId        String
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievementId    String
  achievement      Achievement     @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt       DateTime        @default(now())

  @@unique([profileId, achievementId])
}
